# Copy to apps/web/.env for `npm run dev:web`. That file is gitignored.
#
# Viewers need NONE of this: with no .env at all, the home, board, and team
# pages work, calling /api on the dev server, which proxies to the Worker on
# http://127.0.0.1:8787 (start it with `npm run dev`).

# ── Admin sign-in (only /login and /admin use these) ─────────────────────────
# The same two values as apps/api/.dev.vars. Both are public by design: the
# publishable key only identifies the project, and RLS is the boundary (§31).
# Use the bare project URL, without /rest/v1.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Where the API lives ──────────────────────────────────────────────────────
# Leave unset in development to use the dev-server proxy.
# Set it for a deployed build, or to call a Worker directly. That Worker's
# ALLOWED_ORIGINS must then include this site's origin.
# VITE_API_BASE_URL=https://cfb-api.example.workers.dev

# Dev server only: where the /api proxy points. Defaults to the local Worker.
# API_PROXY_TARGET=http://127.0.0.1:8787

# Deliberately absent: any service-role key. The browser only ever holds the
# publishable key and, for the administrator, their own session token.
