# ─────────────────────────────────────────────────────────────────────────────
# Root .env.example — used by the helper scripts in scripts/ only.
#
# The Worker reads its own config from apps/api/.dev.vars (local) or
# `wrangler secret put` (deployed). The web app will read apps/web/.env.
#
# Copy to .env and fill in. .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project REST/Auth base URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon"/publishable key. Safe to ship to browsers — RLS is the boundary.
SUPABASE_ANON_KEY=

# Used ONLY by scripts/verify-rls.mjs to prove the security model. These are the
# credentials of a throwaway account that is deliberately NOT in the `admins`
# table. Create it by hand in the Supabase Auth dashboard.
VERIFY_NONADMIN_EMAIL=
VERIFY_NONADMIN_PASSWORD=

# Used ONLY by scripts/verify-rls.mjs for the positive (admin) case.
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=

# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY.
# It would bypass every RLS policy and reduce §31 to theater. Nothing in this
# repo needs it. If something appears to, that is a signal the RLS model is
# being worked around rather than used.
